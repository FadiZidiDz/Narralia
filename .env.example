NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Host port for the nginx frontend (Docker). Change if 3000 is already in use on your machine.
FRONTEND_PORT=3000

JWT_SECRET=your_32_char_secret_here
JWT_EXPIRES_IN=7d

MONGODB_URI=mongodb://mongodb:27017/narralia

# === GROQ API — handles ALL AI (text + vision) ===
# One key for everything. Get free at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# === CLOUDINARY — teacher image uploads + storage ===
# Free 25GB tier. Get at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === LANGUAGETOOL (self-hosted Docker — completely free) ===
# Full check endpoint (backend also accepts .../v2 and appends /check)
LANGUAGETOOL_URL=http://languagetool:8010/v2/check

# === TTS (free — uses browser built-in) ===
TTS_PROVIDER=browser

# === STUDENT ILLUSTRATION (text-to-image) ===
# pollinations = gen.pollinations.ai (free flux model with API key from enter.pollinations.ai)
# hf = Hugging Face Inference API (free tier, needs HF_TOKEN)
IMAGE_GEN_PROVIDER=pollinations
# Get a free server key at https://enter.pollinations.ai (required for Pollinations in 2026)
# POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=flux
# HF_TOKEN= (optional fallback if Pollinations fails; or set IMAGE_GEN_PROVIDER=hf)
# Default model works on many free accounts; FLUX and others may require Pro or a custom deployment.
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-2-1
# Optional: override inference base (no trailing slash). If unset, the backend tries the HF router URL then api-inference.
# HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models

# Where to store the student illustration after generation (children-stories-style local Python pipelines are not invoked from Node).
# Default when unset: pollinations-url (no Cloudinary for generated art).
# cloudinary = upload image bytes to Cloudinary (needs valid CLOUDINARY_*).
# pollinations-url = Pollinations generates pixels; backend saves PNG and serves /api/illustrations/public/... (no Cloudinary).
# local-file = always save PNG under backend/storage/illustrations (Docker: mount ./backend/storage).
# ILLUSTRATION_STORAGE=pollinations-url
